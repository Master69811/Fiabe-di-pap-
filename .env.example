# ============================================
# Fiabe di Papà — Variabili d'ambiente
# Copia questo file in .env.local e compila
# ============================================

# --- Supabase ---
# Trovale su: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- ElevenLabs ---
# Trovale su: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=sk_...

# --- OpenAI ---
# Trovale su: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# --- App URL ---
# In locale: http://localhost:3000
# In produzione: https://tuodominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
